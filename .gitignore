# Large pretrained cluster/blueprint artifacts (community-mirrored or self-generated).
# These are multi-GB binary data files, not source, and must never be committed.
# See BUILD_NOTES.md for provenance and how to obtain them.
# Ignore everything in cluster/ except the one small file that ships with the repo.
PokerAI/cluster/*
!PokerAI/cluster/preflopallin1326.1225.bin

__pycache__/
*.pyc
*.o

# dh_native_ai.dylib is a locally-built macOS shared library (built from the
# committed source, PokerAI/tools/dh_native_ai.cpp -- see BUILD_NOTES.md
# section 17 for the exact build command). It, and the convenience symlinks
# that wire it (and the cluster/ dir) into pypokergui/server/, are build
# artifacts / local wiring, not source, and are not committed.
PokerAI/dh_native_ai.dylib
pypokergui/server/dh_native_ai.dylib
pypokergui/server/cluster

# Locally-built validation/diagnostic tools (compiled from committed .cpp
# sources under PokerAI/tools/ -- see BUILD_NOTES.md section 18 for the
# exact build command). Extensionless compiled binaries, not source.
PokerAI/test_blueprint_root_read
PokerAI/tools/test_blueprint_root_read
PokerAI/test_realtime_search_flop
PokerAI/test_realtime_search_chain
PokerAI/tools/build_preflop_cache
PokerAI/tools/test_preflop_cache_validation
PokerAI/tools/test_preflop_cache_timing
PokerAI/tools/test_villain_range_model
PokerAI/tools/test_live_resolver_range_scaling
PokerAI/tools/test_live_resolver_iteration_budget
PokerAI/tools/test_resolver_exploitability
PokerAI/tools/test_run_until_converged
PokerAI/tools/test_partial_cluster_load
PokerAI/tools/split_cluster_file
PokerAI/tools/test_per_file_cluster_load
PokerAI/tools/validate_split_against_monolith
PokerAI/tools/time_per_file_river_load
PokerAI/tools/test_villain_weight_distribution
